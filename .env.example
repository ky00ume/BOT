# 이 파일을 .env 로 복사하고 실제 값을 입력하셰요
# cp .env.example .env

# Discord 봇 토큰 (Discord Developer Portal 에서 발급)
DISCORD_TOKEN=your_bot_token_here

# Discord 사용자 ID (개발자 모드에서 우클릭 → ID 복사)
# 실제 ID 는 이 파일에 커밋하지 말 것.
HYNESS_ID=000000000000000000
MAJESTY_ID=000000000000000000
DRIDER_ID=000000000000000000

# 봇 명령어를 허용할 채널 ID
ALLOWED_CHANNEL_ID=000000000000000000

# (선택) 로그 디렉토리 커스터마이징. 기본값은 <repo>/logs.
# BOT_LOG_DIR=/var/log/vision_town

# (선택) DEBUG=1 이면 파일 로거가 DEBUG 레벨로 동작.
# DEBUG=0
